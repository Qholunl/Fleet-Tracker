<IfModule mod_headers.c>
    # Izinkan akses dari mana saja (untuk frontend di Netlify)
    Header set Access-Control-Allow-Origin "*"
    # Metode yang didukung (tambahkan OPTIONS untuk preflight)
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    # Header yang diizinkan dalam request
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    # Cache preflight request selama 1 hari agar tidak terlalu sering
    Header set Access-Control-Max-Age "86400"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ================================================================
    # 1. TANGANI PREFLIGHT (OPTIONS)
    # ================================================================
    # Setiap request OPTIONS akan langsung dikembalikan dengan status 200 OK
    # Ini penting agar browser (frontend Netlify) tidak error CORS.
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    # ================================================================
    # 2. ROUTING KE API.PHP
    # ================================================================
    # Jika file/folder tidak ada, semua request akan diarahkan ke api.php
    # Contoh: /api/login   → /api/api.php  (agar bisa diproses oleh $method)
    # Contoh: /api/device  → /api/api.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ api.php [QSA,L]
</IfModule>
